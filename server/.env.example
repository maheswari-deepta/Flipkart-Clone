DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
PORT=5000
CLIENT_ORIGIN=*

# SMTP for order confirmation emails (Google Workspace / Gmail)
SMTP_HOST=smtp.gmail.com
